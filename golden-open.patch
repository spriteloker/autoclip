diff --git a/frontend/tests/golden-preview.test.cjs b/frontend/tests/golden-preview.test.cjs
new file mode 100644
index 000000000..32731a938
--- /dev/null
+++ b/frontend/tests/golden-preview.test.cjs
@@ -0,0 +1,38 @@
+const { test } = require('node:test')
+const assert = require('node:assert/strict')
+const path = require('node:path')
+const { loadTs } = require('./load-ts.cjs')
+
+const { goldenBodyScenes, goldenPreviewSegments, goldenTimelineOffset, goldenSourceAt } = loadTs(path.resolve(__dirname, '../src/features/studio/goldenPreview.ts'))
+const scene = (id, start, end) => ({ id, start, end, label: id, evidence: '' })
+const candidate = { id: 'golden-4-4', start: 20, end: 23, text: 'candidate', reason: '' }
+
+test('joined preview plays the selected opening and then every body scene', () => {
+  const draft = { origin: 'auto-content', scenes: [scene('body-1', 1, 5), scene('body-2', 8, 12)] }
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenPreviewSegments(draft, candidate))), [
+    { id: 'golden-open', start: 20, end: 23 },
+    { id: 'body-1', start: 1, end: 5 },
+    { id: 'body-2', start: 8, end: 12 },
+  ])
+})
+
+test('reselecting on a derived draft replaces the old opening in preview', () => {
+  const draft = { origin: 'golden-open', scenes: [scene('golden-open', 1, 3), scene('body', 8, 12)] }
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenBodyScenes(draft).map(x => x.id))), ['body'])
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenPreviewSegments(draft, candidate).map(x => [x.id, x.start]))), [
+    ['golden-open', 20], ['body', 8],
+  ])
+})
+
+test('joined timeline maps playback and seeking across non-contiguous source ranges', () => {
+  const segments = [scene('golden-open', 100, 102), scene('body', 200, 210)]
+  assert.equal(goldenTimelineOffset(segments, 100), 0)
+  assert.equal(goldenTimelineOffset(segments, 101), 1)
+  assert.equal(goldenTimelineOffset(segments, 200), 2)
+  assert.equal(goldenTimelineOffset(segments, 205), 7)
+  assert.equal(goldenTimelineOffset(segments, 210), 12)
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenSourceAt(segments, 0))), { index: 0, time: 100 })
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenSourceAt(segments, 2))), { index: 1, time: 200 })
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenSourceAt(segments, 7))), { index: 1, time: 205 })
+  assert.deepEqual(JSON.parse(JSON.stringify(goldenSourceAt(segments, 99))), { index: 1, time: 210 })
+})
diff --git a/frontend/tests/load-ts.cjs b/frontend/tests/load-ts.cjs
new file mode 100644
index 000000000..396c090b9
--- /dev/null
+++ b/frontend/tests/load-ts.cjs
@@ -0,0 +1,54 @@
+const fs = require('node:fs')
+const path = require('node:path')
+const { runInSandbox } = require('./vm-sandbox.cjs')
+const ts = require('typescript')
+
+const SETTINGS = path.join(__dirname, '../src/features/settings')
+const PRESETS = path.join(__dirname, '../../backend/presets/provider_presets.json')
+const EVENT_CATALOG = path.join(__dirname, '../../backend/core/event_catalog.json')
+const FAILURE_MESSAGES = path.join(__dirname, '../../backend/core/failure_messages.json')
+function jsonModule(file) {
+  const data = JSON.parse(fs.readFileSync(file, 'utf8'))
+  return { default: data, __esModule: true }
+}
+
+function loadTs(file, mocks = {}, fromDir = SETTINGS) {
+  // Tests that run effects pass `window` / `document` via mocks.__globals. It is not a module.
+  const globals = mocks.__globals || {}
+  const localMocks = mocks.__globals ? { ...mocks } : mocks
+  if (localMocks !== mocks) delete localMocks.__globals
+  const abs = path.isAbsolute(file) ? file : path.join(fromDir, file)
+  const source = fs.readFileSync(abs, 'utf8').replace(/\bimport\.meta\.env\b/g, '({})')
+  const { outputText } = ts.transpileModule(source, {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020, jsx: ts.JsxEmit.ReactJSX },
+    fileName: abs,
+  })
+  const exports = {}
+  const requireImpl = (id) => {
+    if (id in localMocks) return localMocks[id]
+    if (id === '@provider-presets') return jsonModule(PRESETS)
+    if (id === '@event-catalog') return jsonModule(EVENT_CATALOG)
+    if (id === '@failure-messages') return jsonModule(FAILURE_MESSAGES)
+    if (id === 'react/jsx-runtime' || id === 'react') return require(id)
+    if (id.startsWith('.')) {
+      const resolved = path.join(path.dirname(abs), id)
+      // Static assets (OhMyGame-style provider icons): expose a string URL for <img src>.
+      if (/\.(svg|png|jpe?g|webp|gif)(\?.*)?$/i.test(id)) {
+        const asset = resolved.split('?')[0]
+        if (!fs.existsSync(asset)) throw new Error(id)
+        return asset
+      }
+      const hit = ['', '.ts', '.tsx', '.json'].map(ext => resolved + ext).find(candidate => fs.existsSync(candidate))
+      if (!hit) throw new Error(id)
+      if (hit.endsWith('.json')) return JSON.parse(fs.readFileSync(hit, 'utf8'))
+      return loadTs(hit, mocks, path.dirname(hit))
+    }
+    throw new Error(id)
+  }
+  // console is passed explicitly so a console.error inside the module reaches the strict setup (#299).
+  // URLSearchParams, Event, timers and AbortController stay explicit: setup only fills URL / URLSearchParams (#272).
+  runInSandbox(outputText, { exports, URL, URLSearchParams, Event, console, ...globals, require: requireImpl, crypto: { randomUUID: () => 'uuid' }, Map, Set, setTimeout, clearTimeout, AbortController })
+  return exports
+}
+
+module.exports = { loadTs, PRESETS }
diff --git a/frontend/tests/vm-sandbox.cjs b/frontend/tests/vm-sandbox.cjs
new file mode 100644
index 000000000..796b61592
--- /dev/null
+++ b/frontend/tests/vm-sandbox.cjs
@@ -0,0 +1,26 @@
+// The one way tests evaluate source in a vm sandbox (#313). Every loader goes through runInSandbox so a
+// console.error inside the loaded module reaches the strict setup (tests/setup.cjs): the sandbox always gets the
+// monitored global console. A test that passes its own console keeps its other methods, but error still goes to the
+// monitored one. Nothing else is injected here (URL / URLSearchParams come from setup.cjs, #209/#272).
+// tests/vm-sandbox.test.cjs fails when a test file calls node:vm directly instead.
+'use strict'
+const vm = require('node:vm')
+
+function withMonitoredConsole(context) {
+  const ctx = context ?? {}
+  const own = ctx.console
+  if (own === undefined || own === console) {
+    ctx.console = console
+  } else {
+    const merged = Object.create(own)
+    merged.error = (...args) => console.error(...args)
+    ctx.console = merged
+  }
+  return ctx
+}
+
+function runInSandbox(code, context, options) {
+  return vm.runInNewContext(code, withMonitoredConsole(context), options)
+}
+
+module.exports = { runInSandbox }
